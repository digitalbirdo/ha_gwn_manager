{
  "config": {
    "step": {
      "user": {
        "title": "Connect to GWN Manager",
        "description": "Create an App ID and secret in GWN Manager / GWN.Cloud under System → API Developer Mode.",
        "data": {
          "server_url": "Server URL",
          "app_id": "App ID",
          "app_secret": "App secret",
          "verify_ssl": "Verify SSL certificate"
        },
        "data_description": {
          "server_url": "Your GWN Manager, e.g. {local_example}, or the GWN.Cloud region, e.g. {cloud_example}",
          "app_id": "App ID from API Developer Mode",
          "verify_ssl": "Disable for a GWN Manager with a self-signed certificate"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate GWN Manager",
        "description": "The secret for App ID {app_id} was rejected. Please enter the current secret.",
        "data": {
          "app_secret": "App secret"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This GWN Manager and App ID are already configured",
      "reauth_successful": "Re-authentication was successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "presence_interval": "Presence update interval",
          "away_delay": "Consider away after",
          "scan_interval": "Update interval for all other data",
          "track_offline_clients": "Track offline clients",
          "ssid_filter": "Only track clients of these SSIDs"
        },
        "data_description": {
          "presence_interval": "How often to check which clients are connected. Connects and disconnects show up in GWN Manager right away.",
          "away_delay": "A client is only reported away after being disconnected this long, so phones briefly dropping Wi-Fi don't flap. 0 = immediately.",
          "scan_interval": "Offline clients, devices and device details. GWN Manager refreshes signal strength and other measurements only every ~90 s.",
          "track_offline_clients": "Create entities for all clients known to GWN Manager, not only for currently connected ones",
          "ssid_filter": "Leave empty to track clients of all SSIDs. Entities of clients that are already set up are kept."
        }
      }
    }
  },
